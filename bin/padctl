#!/bin/sh
# The plugin's CLI and daemon. Pure Python standard library: nothing to build.
# -P keeps the current directory off sys.path, so files where padctl happens
# to be run from cannot stand in for padd or the standard library.
here=$(dirname -- "$(readlink -f -- "$0")")
python=/usr/bin/python3
[ -x "$python" ] || python=python3
PYTHONPATH="$here/..${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 exec "$python" -P -m padd "$@"
